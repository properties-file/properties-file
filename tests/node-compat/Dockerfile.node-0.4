# Verifies that the compiled output works on Node.js 0.4.0 (February 2011).
# This is the first stable Node.js release with ES5 support.
#
# Usage:
#   docker build --platform linux/amd64 -f tests/node-compat/Dockerfile.node-0.4 .
#
# The Node.js binary is compiled from source without SSL (our parser
# doesn't use crypto). This takes ~12 minutes on first build but the
# Docker layer is cached for subsequent runs.

FROM ubuntu:12.04 AS builder

RUN sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list \
    && sed -i 's|security.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list \
    && apt-get update && apt-get install -y \
    build-essential python curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN curl -kL https://nodejs.org/dist/v0.4.0/node-v0.4.0.tar.gz | tar xz

WORKDIR /build/node-v0.4.0
RUN ./configure --prefix=/usr/local --without-ssl && make && make install

# Final stage — only the compiled binary + test files.
FROM ubuntu:12.04

RUN sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list \
    && sed -i 's|security.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list \
    && apt-get update && apt-get install -y libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/bin/node /usr/local/bin/node

# Install the package the way npm lays it out for a consumer: the root package.json (whose
# `main` serves `require('properties-file')`), the generated legacy subpath stubs (whose `main`
# serves `require('properties-file/editor')` etc. on runtimes that predate the `exports` map,
# like this one), and the CommonJS build. Run `npm run build-artifacts` first: the stubs are
# generated, not checked in. The bundler stubs are left out on purpose: the bundler
# integrations run inside modern build tools, never on Node.js 0.4.
COPY package.json /app/node_modules/properties-file/package.json
COPY editor /app/node_modules/properties-file/editor
COPY escape /app/node_modules/properties-file/escape
COPY parser /app/node_modules/properties-file/parser
COPY unescape /app/node_modules/properties-file/unescape
COPY dist/cjs /app/node_modules/properties-file/dist/cjs
COPY tests/functional/golden.json /app/golden.json
COPY tests/functional/run-cjs.js /app/run-cjs.js

# 1. Load every entry point by file path: proves the compiled code itself runs on Node.js 0.4.
RUN node /app/run-cjs.js /app/node_modules/properties-file/dist/cjs

# 2. Load every entry point by package name (`require('properties-file/editor')`, …), resolved
#    from /app/node_modules through package.json `main` fields: proves the published layout
#    resolves on a runtime without `exports` support. Kept as its own step so a resolution
#    failure is reported separately from a behavioral one; run-cjs.js names the request that
#    failed and exits non-zero, which fails the image build.
RUN node /app/run-cjs.js --package-name
